<UserControl x:Class="WinDownloader.Views.UpdateListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select all" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding SelectAllCommand}" CommandParameter="{Binding Group, ElementName=root}"/>
                <Button Content="Select none" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding SelectNoneCommand}" CommandParameter="{Binding Group, ElementName=root}"/>
                <Button Content="Rescan" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding ScanCommand}"/>
                <Button Content="Install selected" Style="{StaticResource PrimaryButton}"
                        Command="{Binding InstallSelectedCommand}" CommandParameter="{Binding Group, ElementName=root}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Heading, ElementName=root}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Blurb, ElementName=root}" Style="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <!-- Empty state -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24"
                Visibility="{Binding Items.Count, ElementName=root, Converter={StaticResource CountVis}, ConverterParameter=zero}">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource GreenBrush}" Opacity="0.9" Margin="0,0,16,0">
                    <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Nothing to install" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding EmptyText, ElementName=root}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items, ElementName=root}" ItemTemplate="{StaticResource UpdateRow}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
