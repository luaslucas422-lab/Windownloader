<UserControl x:Class="WinDownloader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Tell WinDownloader about this PC and what it should look for." Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <!-- Windows version -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows version" Style="{StaticResource H2}"/>
                    <TextBlock Text="Win Setup detected this during installation. Leave it on Auto unless detection got it wrong." Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Left" Style="{StaticResource DarkCombo}" ItemsSource="{Binding WindowsVersionChoices}" SelectedItem="{Binding Settings.WindowsVersion}"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Os.Name, StringFormat='Detected: {0}'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Os.Summary}" Style="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- What to scan -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="What to check" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.IncludeDrivers}" Content="Driver updates (from Microsoft Update)"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.IncludeOptional}" Content="Optional Windows updates and previews"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.IncludeApps}" Content="App updates (winget)"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.UseMicrosoftUpdate}" Content="Use Microsoft Update (adds Office and other Microsoft products)"/>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.ScanOnLaunch}" Content="Scan automatically when WinDownloader opens"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AskBeforeRestart}" Content="Ask to restart when an update needs it"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/>
                <TextBlock Text="{Binding SettingsSavedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Content="Open settings folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                        WinDownloader 1.0 by DarkerDawnFR. Updates are fetched and installed through the official Windows Update Agent,
                        so everything you see here is the same as what Settings → Windows Update offers — just in one place, with drivers, devices and apps included.
                        Source code and new releases: github.com/luaslucas422-lab/Windownloader
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
