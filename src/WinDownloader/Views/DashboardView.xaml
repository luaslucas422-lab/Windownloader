<UserControl x:Class="WinDownloader.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:WinDownloader.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Install all" Style="{StaticResource SecondaryButton}" Command="{Binding InstallAllCommand}" Margin="0,0,10,0"/>
                    <Button Content="Scan now" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>

            <!-- Score + summary -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="UPDATE SCORE" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                        <ctl:ScoreGauge Width="230" Height="230" Margin="0,10,0,4"
                                        Value="{Binding ScoreForGauge}" HasValue="{Binding HasScore}"
                                        Label="{Binding ScoreHeadlineText}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="260"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Windows -->
                    <Border Style="{StaticResource Card}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonUp="GoWindows">
                        <StackPanel>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="{StaticResource IconWindows}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="WINDOWS UPDATES" Style="{StaticResource Eyebrow}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding WindowsCardText}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="Security, quality and feature updates" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Drivers -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,8" Cursor="Hand" MouseLeftButtonUp="GoDrivers">
                        <StackPanel>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="{StaticResource IconDrivers}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="DRIVERS" Style="{StaticResource Eyebrow}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DriversCardText}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="Graphics, chipset, network, USB, audio" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Devices -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,8,0" Cursor="Hand" MouseLeftButtonUp="GoDevices">
                        <StackPanel>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="{StaticResource IconDevices}" Stroke="{StaticResource GreenBrush}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="DEVICES &amp; USB" Style="{StaticResource Eyebrow}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding DevicesCardText}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="Hardware health and installed driver ages" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Apps -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,8,0,0" Cursor="Hand" MouseLeftButtonUp="GoApps">
                        <StackPanel>
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="{StaticResource IconApps}" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock Text="APPS" Style="{StaticResource Eyebrow}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding AppsCardText}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="Installed programs via winget" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Quick stats row -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Text="PENDING" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding TotalPending}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="INSTALLED THIS SESSION" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding InstalledThisSession}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DEVICE PROBLEMS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding DeviceProblems}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="WINDOWS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding WindowsVersionLabel}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Activity -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,16" MinHeight="160">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Log}" MaxHeight="260">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
