<UserControl x:Class="WinDownloader.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="USB only" Style="{StaticResource Switch}" IsChecked="{Binding UsbOnly}" Margin="0,0,16,0"/>
                <Button Content="Device Manager" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding OpenDeviceManagerCommand}"/>
                <Button Content="Rescan hardware" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding RescanHardwareCommand}"/>
                <Button Content="Install driver updates" Style="{StaticResource PrimaryButton}" Command="{Binding InstallSelectedCommand}" CommandParameter="Drivers"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Devices &amp; USB" Style="{StaticResource H1}"/>
                <TextBlock Text="Every device Windows knows about, the driver it is using, and whether a newer one is waiting on Windows Update." Style="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VisibleDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center"
                                         Fill="{Binding StatusKind, Converter={StaticResource StatusKindBrush}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding AvailableUpdate.Title}" Foreground="{StaticResource CyanBrush}" FontSize="12" Margin="0,2,0,0"
                                               Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{Binding StatusKind, Converter={StaticResource StatusKindBrush}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
