<Window x:Class="WinDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinDownloader.Views"
        Title="WinDownloader" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────── Sidebar ───────── -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,16,26">
                    <Image Source="/Assets/logo.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinDownloader" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="by DarkerDawnFR" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: version chip -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="12,10" CornerRadius="8" Background="#121B2E">
                    <StackPanel>
                        <TextBlock Text="THIS PC" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding WindowsVersionLabel}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Os.Summary}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="{StaticResource IconDashboard}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Dashboard}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Windows updates" Tag="{StaticResource IconWindows}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Windows}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Drivers" Tag="{StaticResource IconDrivers}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Drivers}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Devices &amp; USB" Tag="{StaticResource IconDevices}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Devices}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Apps" Tag="{StaticResource IconApps}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Apps}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="History" Tag="{StaticResource IconHistory}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=History}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="{StaticResource IconSettings}"
                                 IsChecked="{Binding Page, Converter={StaticResource StringEqualsBool}, ConverterParameter=Settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───────── Content ───────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Busy / restart banners -->
            <StackPanel>
                <Border Background="#1D4ED8" Padding="24,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="12,5" Command="{Binding CancelCommand}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" Foreground="White"/>
                            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Foreground="White" Background="#3B6FE0" Margin="0,6,0,0" Width="260" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Background="#B45309" Padding="24,10" Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart now" Style="{StaticResource SecondaryButton}" Padding="12,5" Command="{Binding RestartCommand}"/>
                        <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="A restart is required to finish installing updates."/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Pages -->
            <Grid Grid.Row="1">
                <views:DashboardView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Dashboard}"/>
                <views:UpdateListView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Windows}"
                                      Heading="Windows updates" Group="Windows" Items="{Binding WindowsUpdates}"
                                      Blurb="Security, quality and feature updates straight from Windows Update / Microsoft Update."
                                      EmptyText="No Windows updates are waiting. Run a scan to check again."/>
                <views:UpdateListView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Drivers}"
                                      Heading="Driver updates" Group="Drivers" Items="{Binding DriverUpdates}"
                                      Blurb="Drivers published to Microsoft Update by hardware makers — graphics, chipset, network, USB, audio and more."
                                      EmptyText="No driver updates found. Windows is only offered drivers that manufacturers submit to Microsoft; check the maker's site for the very latest."/>
                <views:UpdateListView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Apps}"
                                      Heading="App updates" Group="Apps" Items="{Binding AppUpdates}"
                                      Blurb="Installed programs with newer versions available, via the Windows Package Manager (winget)."
                                      EmptyText="All detected apps are current, or winget is not installed on this PC."/>
                <views:DevicesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Devices}"/>
                <views:HistoryView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=History}"/>
                <views:SettingsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Settings}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
