<Window x:Class="WinSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win Setup" Height="540" Width="820" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <Border Background="{StaticResource Side}" Padding="26,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,34">
                    <Image Source="/Assets/logo.png" Width="36" Height="36" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Win Setup" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="WinDownloader installer" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="© DarkerDawnFR" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock x:Name="Step0" Text="1  Welcome" Style="{StaticResource StepLabel}"/>
                    <TextBlock x:Name="Step1" Text="2  Windows version" Style="{StaticResource StepLabel}"/>
                    <TextBlock x:Name="Step2" Text="3  Options" Style="{StaticResource StepLabel}"/>
                    <TextBlock x:Name="Step3" Text="4  Install" Style="{StaticResource StepLabel}"/>
                    <TextBlock x:Name="Step4" Text="5  Done" Style="{StaticResource StepLabel}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="36,32,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0 Welcome -->
            <StackPanel x:Name="PageWelcome">
                <TextBlock Text="Welcome to WinDownloader" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,20" FontSize="14">
                    WinDownloader keeps your PC current: Windows updates, driver updates, USB and other device drivers, and app updates — all in one dashboard with a single score that tells you how up to date you are.
                </TextBlock>
                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="This setup will" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="•  Ask which Windows version you are running (we try to detect it)" Style="{StaticResource Muted}"/>
                        <TextBlock Text="•  Install WinDownloader to Program Files" Style="{StaticResource Muted}"/>
                        <TextBlock Text="•  Add Start menu and desktop shortcuts, if you want them" Style="{StaticResource Muted}"/>
                        <TextBlock Text="•  Register an uninstaller in Apps &amp; features" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PayloadWarning" Foreground="#F59E0B" Margin="0,16,0,0" Visibility="Collapsed"
                           Text="This copy of Win Setup has no app payload inside it. Download WinSetup.exe from the GitHub Releases page."/>
            </StackPanel>

            <!-- 1 Windows version -->
            <StackPanel x:Name="PageVersion" Visibility="Collapsed">
                <TextBlock Text="Which Windows are you running?" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,18" FontSize="14"
                           Text="We detected it for you. Pick the right one — you can change it any time in WinDownloader's Settings."/>
                <RadioButton x:Name="OptAuto" Style="{StaticResource OptionCard}" IsChecked="True">
                    <StackPanel>
                        <TextBlock x:Name="DetectedTitle" Text="Use what we detected" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="DetectedDetail" Style="{StaticResource Muted}" Text="…"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OptWin11" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock Text="Windows 11" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Build 22000 or newer (21H2, 22H2, 23H2, 24H2, 25H2…)" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OptWin10" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock Text="Windows 10" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Build 19045 or older (22H2 and earlier)" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 2 Options -->
            <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                <TextBlock Text="Install options" Style="{StaticResource H1}"/>
                <TextBlock Text="Where to put it and what shortcuts to create." Style="{StaticResource Muted}" Margin="0,8,0,18" FontSize="14"/>
                <TextBlock Text="Install folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Secondary}" Padding="14,8" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="FolderBox" Padding="10,8" FontSize="13" Background="{StaticResource Card}" Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Line}" BorderThickness="1" CaretBrush="White"/>
                </DockPanel>
                <CheckBox x:Name="ChkDesktop" Style="{StaticResource Check}" Content="Create a desktop shortcut" IsChecked="True"/>
                <CheckBox x:Name="ChkStart" Style="{StaticResource Check}" Content="Add to the Start menu" IsChecked="True"/>
                <CheckBox x:Name="ChkLaunch" Style="{StaticResource Check}" Content="Launch WinDownloader when setup finishes" IsChecked="True"/>
            </StackPanel>

            <!-- 3 Installing -->
            <StackPanel x:Name="PageInstall" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="InstallTitle" Text="Installing WinDownloader…" Style="{StaticResource H1}"/>
                <TextBlock x:Name="InstallStatus" Text="Preparing" Style="{StaticResource Muted}" Margin="0,8,0,18" FontSize="14"/>
                <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
                <TextBlock x:Name="InstallLog" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,16,0,0" MaxHeight="160"/>
            </StackPanel>

            <!-- 4 Done -->
            <StackPanel x:Name="PageDone" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Green}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <Path Data="M5,12 L10,17 L19,7" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="26" Height="26" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="DoneTitle" Text="WinDownloader is installed" Style="{StaticResource H1}"/>
                <TextBlock x:Name="DoneDetail" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="14"/>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="1" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource Secondary}" Click="Cancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="Back" Style="{StaticResource Secondary}" Margin="0,0,10,0" Click="Back_Click"/>
                    <Button x:Name="BtnNext" Content="Next" Style="{StaticResource Primary}" Click="Next_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
